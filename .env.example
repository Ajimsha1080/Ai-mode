# ==============================================================================
# SHOPMATE AAAS E-COMMERCE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# All values below are non-sensitive templates. Do not commit actual secrets.
# Generate strong production secrets using: bash scripts/gen-secrets.sh
# ==============================================================================

# Application Environment Mode ('production' | 'development' | 'dev')
APP_ENV=production
NODE_ENV=production
PORT=3000

# Database Configuration (PostgreSQL 16 with pgvector)
# App containers connect as unprivileged 'app_user' (RLS strictly enforced).
# Migrations run under owner/superuser 'postgres' role.
POSTGRES_DB=aaas_enterprise
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_APP_USER=app_user
POSTGRES_APP_PASSWORD=
DATABASE_URL=postgresql+asyncpg://app_user:${POSTGRES_APP_PASSWORD}@localhost:5432/aaas_enterprise
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@localhost:5432/aaas_enterprise

# Redis Distributed Cache, Sessions & Rate Limiter
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# Authentication & Session Security (Symmetric 32+ char secret for user session cookies)
SESSION_JWT_SECRET=
AUTH_COOKIE_NAME=aaas_session_token

# Service-to-Service Asymmetric Authentication (RS256)
# Next.js signs with PRIVATE key; Python FastAPI verifies with PUBLIC key.
# Provide as standard PEM strings (with \n) or base64-encoded PEM strings.
SERVICE_JWT_PRIVATE_KEY=
SERVICE_JWT_PUBLIC_KEY=

# Data-at-Rest Encryption (AES-256-GCM master key - minimum 32 chars)
ENCRYPTION_KEY=

# Internal Network Routing
PYTHON_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Providers Configuration (Sarvam AI / Anthropic / OpenAI / Ollama)
LLM_PROVIDER=sarvam
LLM_MODEL=sarvam-105b-conversations
SARVAM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Stripe Enterprise Billing (Optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# Razorpay Regional Payments (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email & Verification (Resend / AWS SES)
RESEND_API_KEY=
EMAIL_FROM=

# Cloudflare Turnstile Anti-Abuse (Optional)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Observability & Monitoring
SENTRY_DSN=
